{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git worktree list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./**/secrets/**)"
    ]
  }
}
